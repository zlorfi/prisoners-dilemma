# --- Admin bootstrap -------------------------------------------------------
# Created on first boot only (when the admins table is empty).
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed to the logs once.
ADMIN_PASSWORD=change-me-please

# --- Secrets ---------------------------------------------------------------
# Used to sign cookies. Generate with: openssl rand -hex 32
# If unset, a secret is generated and persisted in the data volume.
SESSION_SECRET=

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Where the SQLite file lives (mounted volume in docker-compose).
DATA_DIR=/data

# Public origin used to render shareable links / QR codes.
# e.g. https://dilemma.example.com  — leave empty to derive from the request.
#
# NOTE: these three values override the docker-compose defaults. Behind
# Traefik on https://pd.zlor.fi they must all be set as shown below, or you
# get http:// share links, every client looking like the proxy's IP, and
# cookies without the Secure flag.
PUBLIC_ORIGIN=https://pd.zlor.fi

# Set to 1 when running behind a reverse proxy (nginx, Traefik, Caddy...)
# so client IPs are read from X-Forwarded-For.
TRUST_PROXY=1

# Set to 1 ONLY when the app is served over HTTPS. Cookies will not be
# sent over plain HTTP when this is on.
COOKIE_SECURE=1

# Minutes a prefilled name stays reserved for a visitor who has not voted yet.
NAME_RESERVATION_MINUTES=45
